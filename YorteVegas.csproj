<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>YorteVegas</RootNamespace>
    <AssemblyName>YorteVegas</AssemblyName>
    <Version>0.1.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\YorteVegas.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\AppIcon.png" />
    <Resource Include="Assets\sample2.png" />
    <None Include="tools\ffmpeg.exe" Condition="Exists('tools\ffmpeg.exe')"
          CopyToOutputDirectory="PreserveNewest" Link="ffmpeg.exe" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Nickvision.MPVSharp" Version="2023.9.0" />
    <PackageReference Include="Nickvision.MPVSharp.Bundled" Version="2023.9.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

</Project>
