<Window x:Class="YorteVegas.Dialogs.RenameTrackDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename layer" Width="440" SizeToContent="Height"
        Icon="pack://application:,,,/assets/appicon.png"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#080A11" Foreground="#E6EEF6">
  <StackPanel Margin="24,20,24,18">
    <TextBlock Text="Rename layer" FontSize="16" FontWeight="SemiBold"/>
    <TextBlock Text="Give this layer a short name. It is shown in the timeline header."
               Foreground="#8EA0B4" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
    <TextBox x:Name="NameBox" Margin="0,16,0,0" MaxLength="48"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="Cancel" Style="{StaticResource BaseButton}" Width="92" Margin="0,0,8,0"
              Click="Cancel_Click" IsCancel="True"/>
      <Button Content="Rename" Style="{StaticResource AccentButton}" Width="100"
              IsDefault="True" Click="Rename_Click"/>
    </StackPanel>
  </StackPanel>
</Window>
