<Window x:Class="YorteVegas.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="520" SizeToContent="Height"
        Icon="pack://application:,,,/assets/appicon.png"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#080A11" Foreground="#E6EEF6">
  <Window.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#8EA0B4"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>
    <Style x:Key="HintText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#5C6B7E"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </Window.Resources>

  <StackPanel Margin="24,20,24,18">
    <TextBlock Text="Settings" FontSize="17" FontWeight="SemiBold"/>
    <TextBlock Text="Defaults for new projects and the editor preview."
               Foreground="#8EA0B4" FontSize="11" Margin="0,4,0,0"/>

    <Border Style="{StaticResource Card}" Margin="0,18,0,0">
      <StackPanel>
        <TextBlock Text="NEW PROJECT DEFAULTS" Style="{StaticResource FieldLabel}"/>
        <Grid Margin="0,2,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="Width" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="WidthBox"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="0,0,10,0">
            <TextBlock Text="Height" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="HeightBox"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Frame rate" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="FpsBox"/>
          </StackPanel>
        </Grid>
        <TextBlock Text="Used when YorteVegas starts a fresh untitled project."
                   Style="{StaticResource HintText}" Margin="0,8,0,0"/>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}" Margin="0,10,0,0">
      <StackPanel>
        <TextBlock Text="PREVIEW" Style="{StaticResource FieldLabel}"/>
        <Grid Margin="0,3,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="44"/>
          </Grid.ColumnDefinitions>
          <Slider x:Name="VolumeSlider" Style="{StaticResource ThinSlider}" Minimum="0" Maximum="100"
                  SmallChange="1" LargeChange="5" VerticalAlignment="Center"/>
          <TextBlock x:Name="VolumeText" Grid.Column="1" Text="100%" HorizontalAlignment="Right"
                     VerticalAlignment="Center" FontFamily="Consolas, Segoe UI" FontSize="10.5"
                     Foreground="#8EA0B4"/>
        </Grid>
        <TextBlock Text="Monitor volume for timeline playback." Style="{StaticResource HintText}" Margin="0,6,0,0"/>

        <Grid Margin="0,14,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Still image duration" VerticalAlignment="Center"
                     Foreground="#C7D6E6" FontSize="11"/>
          <TextBox x:Name="ImageDurationBox" Grid.Column="1" Margin="10,0,8,0" TextAlignment="Center"/>
          <TextBlock Grid.Column="2" Text="seconds" VerticalAlignment="Center"
                     Foreground="#8EA0B4" FontSize="10.5"/>
        </Grid>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}" Margin="0,10,0,0">
      <CheckBox x:Name="OpenLastCheck" Content="Reopen the last project when YorteVegas starts"/>
    </Border>

    <TextBlock x:Name="ErrorText" Foreground="#F87171" FontSize="10.5" Margin="0,10,0,0"
               Visibility="Collapsed"/>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="Cancel" Style="{StaticResource BaseButton}" Width="92" Margin="0,0,8,0"
              Click="Cancel_Click" IsCancel="True"/>
      <Button Content="Save" Style="{StaticResource AccentButton}" Width="92" IsDefault="True"
              Click="Save_Click"/>
    </StackPanel>
  </StackPanel>
</Window>
