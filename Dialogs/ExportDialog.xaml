<Window x:Class="YorteVegas.Dialogs.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export video" Width="560" SizeToContent="Height"
        Icon="pack://application:,,,/assets/appicon.png"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#080A11" Foreground="#E6EEF6">
  <Window.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#8EA0B4"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>

    <Style x:Key="ExportCard" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#E6EEF6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Background="#111A27" BorderBrush="#1A2636" BorderThickness="1"
                    CornerRadius="6" Padding="14,11">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#16202D"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#2A3E54"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#142334"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#2E9BFF"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="24,20,24,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Text="Export video" FontSize="17" FontWeight="SemiBold"/>
      <TextBlock Text="Choose a quality. That’s it." Foreground="#8EA0B4" FontSize="11" Margin="0,4,0,0"/>
    </StackPanel>

    <StackPanel Grid.Row="1" Margin="0,18,0,0">
      <RadioButton x:Name="GreatCard" Style="{StaticResource ExportCard}" GroupName="Quality">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="GreatTitle" Text="Great" FontSize="12.5" FontWeight="SemiBold"/>
            <TextBlock x:Name="GreatTagline" Text="Best quality" Foreground="#5FBBFF" FontSize="10.5"
                       Margin="9,1,0,0"/>
          </StackPanel>
          <TextBlock x:Name="GreatDescription" Text="Keeps the full project resolution."
                     Foreground="#8EA0B4" FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
      </RadioButton>

      <RadioButton x:Name="GoodCard" Style="{StaticResource ExportCard}" GroupName="Quality" IsChecked="True">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="GoodTitle" Text="Good" FontSize="12.5" FontWeight="SemiBold"/>
            <TextBlock x:Name="GoodTagline" Text="Balanced" Foreground="#5FBBFF" FontSize="10.5"
                       Margin="9,1,0,0"/>
          </StackPanel>
          <TextBlock x:Name="GoodDescription" Text="A sensible file size for everyday sharing."
                     Foreground="#8EA0B4" FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
      </RadioButton>

      <RadioButton x:Name="LightCard" Style="{StaticResource ExportCard}" GroupName="Quality">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="LightTitle" Text="Light for WhatsApp" FontSize="12.5" FontWeight="SemiBold"/>
            <TextBlock x:Name="LightTagline" Text="Made for sharing" Foreground="#5FBBFF" FontSize="10.5"
                       Margin="9,1,0,0"/>
          </StackPanel>
          <TextBlock x:Name="LightDescription" Text="A smaller file that sends easily in WhatsApp."
                     Foreground="#8EA0B4" FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
      </RadioButton>
    </StackPanel>

    <StackPanel Grid.Row="2" Margin="0,4,0,0">
      <TextBlock Text="SAVE TO" Style="{StaticResource FieldLabel}"/>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="OutputBox" IsReadOnly="True" Margin="0,0,8,0" FontSize="10.5"/>
        <Button Grid.Column="1" Content="Change…" Style="{StaticResource BaseButton}" Width="88"
                Click="Browse_Click"/>
      </Grid>
    </StackPanel>

    <TextBlock Grid.Row="3"
               Text="Renders all video layers with their opacity and crossfades, and mixes the audible clips."
               Foreground="#5C6B7E" FontSize="9.5" Margin="0,8,0,0" TextWrapping="Wrap"/>

    <StackPanel Grid.Row="4" Margin="0,12,0,0">
      <TextBlock x:Name="ErrorText" Foreground="#F87171" FontSize="10.5" TextWrapping="Wrap"
                 Visibility="Collapsed" MaxHeight="70"/>
      <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,2,0,0">
        <ProgressBar Height="4" IsIndeterminate="True" Background="#111A27" Foreground="#2E9BFF"
                     BorderThickness="0"/>
        <TextBlock x:Name="ProgressText" Text="Preparing…" Foreground="#8EA0B4" FontSize="10"
                   Margin="0,6,0,0"/>
      </StackPanel>
    </StackPanel>

    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource BaseButton}" Width="104"
              Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True"/>
      <Button x:Name="ExportButton" Content="Export" Style="{StaticResource AccentButton}" Width="112"
              IsDefault="True" Click="Export_Click"/>
    </StackPanel>
  </Grid>
</Window>
