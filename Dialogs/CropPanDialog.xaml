<Window x:Class="YorteVegas.Dialogs.CropPanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:YorteVegas.Controls"
        Title="Crop, pan and position" Width="820" SizeToContent="Height"
        Icon="pack://application:,,,/assets/appicon.png"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#080A11" Foreground="#E6EEF6">
  <Window.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#8EA0B4"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>

    <Style x:Key="PresetButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
      <Setter Property="Padding" Value="9,4"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>

    <Style x:Key="DarkTabControl" TargetType="TabControl">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <TabPanel Grid.Row="0" IsItemsHost="True" Margin="0,0,0,8"/>
              <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DarkTabItem" TargetType="TabItem">
      <Setter Property="Foreground" Value="#8EA0B4"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Bd" Padding="14,7" Margin="0,0,6,0" CornerRadius="4"
                    Background="Transparent">
              <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#16202D"/>
                <Setter Property="Foreground" Value="#DCE8F4"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#1E2C3E"/>
                <Setter Property="Foreground" Value="#E6EEF6"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <StackPanel Margin="24,20,24,18">
    <TextBlock Text="Crop, pan and position" FontSize="16" FontWeight="SemiBold"/>
    <TextBlock Text="Crop the visible area, then place the clip on the project frame."
               Foreground="#8EA0B4" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>

    <TabControl x:Name="Tabs" Style="{StaticResource DarkTabControl}" Margin="0,12,0,0"
                SelectionChanged="Tabs_SelectionChanged">
      <TabItem Header="Crop" Style="{StaticResource DarkTabItem}">
        <Border Background="#05070A" BorderBrush="#1A2636" BorderThickness="1"
                HorizontalAlignment="Center">
          <controls:CropEditor x:Name="Editor" Width="760" Height="428"/>
        </Border>
      </TabItem>

      <TabItem Header="Position" Style="{StaticResource DarkTabItem}">
        <StackPanel>
          <Border Background="#05070A" BorderBrush="#1A2636" BorderThickness="1"
                  HorizontalAlignment="Center">
            <controls:PositionEditor x:Name="PositionView" Width="760" Height="428"/>
          </Border>

          <StackPanel Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="SIZE" Style="{StaticResource FieldLabel}" Margin="0,0,8,0"
                         VerticalAlignment="Center"/>
              <Slider x:Name="ScaleSlider" Style="{StaticResource ThinSlider}" Width="180"
                      Minimum="0.1" Maximum="4" SmallChange="0.05" LargeChange="0.25"
                      Value="1" ValueChanged="ScaleSlider_ValueChanged"
                      VerticalAlignment="Center"/>
              <TextBlock x:Name="ScaleText" Text="100%" Foreground="#DCE8F4"
                         FontFamily="Consolas, Segoe UI" FontSize="10.5" Width="46"
                         Margin="10,0,0,0" VerticalAlignment="Center"/>
              <Border Width="1" Height="16" Background="#1E2A3A" Margin="10,0"/>
              <Button Content="Full frame" Style="{StaticResource PresetButton}"
                      Click="FullFrame_Click"/>
              <Button Content="Center" Style="{StaticResource PresetButton}"
                      Click="Center_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
              <TextBlock Text="CORNER" Style="{StaticResource FieldLabel}" Margin="0,0,8,0"
                         VerticalAlignment="Center"/>
              <Button Content="Top left" Style="{StaticResource PresetButton}" Tag="TopLeft"
                      Click="Corner_Click"/>
              <Button Content="Top right" Style="{StaticResource PresetButton}" Tag="TopRight"
                      Click="Corner_Click"/>
              <Button Content="Bottom left" Style="{StaticResource PresetButton}" Tag="BottomLeft"
                      Click="Corner_Click"/>
              <Button Content="Bottom right" Style="{StaticResource PresetButton}" Tag="BottomRight"
                      Click="Corner_Click"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </TabItem>
    </TabControl>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="Reset" Style="{StaticResource GhostButton}" Width="86" Margin="0,0,8,0"
              Click="Reset_Click"/>
      <Button Content="Cancel" Style="{StaticResource BaseButton}" Width="92" Margin="0,0,8,0"
              Click="Cancel_Click" IsCancel="True"/>
      <Button Content="Apply" Style="{StaticResource AccentButton}" Width="100"
              IsDefault="True" Click="Apply_Click"/>
    </StackPanel>
  </StackPanel>
</Window>
