<Window x:Class="YorteVegas.Dialogs.CropPanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:YorteVegas.Controls"
        Title="Crop and pan" Width="820" SizeToContent="Height"
        Icon="pack://application:,,,/assets/appicon.png"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#080A11" Foreground="#E6EEF6">
  <StackPanel Margin="24,20,24,18">
    <TextBlock Text="Crop and pan" FontSize="16" FontWeight="SemiBold"/>
    <TextBlock Text="Drag the box to pan. Drag its edges or corners to choose the visible area."
               Foreground="#8EA0B4" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>

    <Border Background="#05070A" BorderBrush="#1A2636" BorderThickness="1"
            Margin="0,14,0,0" HorizontalAlignment="Center">
      <controls:CropEditor x:Name="Editor" Width="760" Height="428"/>
    </Border>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="Reset" Style="{StaticResource GhostButton}" Width="86" Margin="0,0,8,0"
              Click="Reset_Click"/>
      <Button Content="Cancel" Style="{StaticResource BaseButton}" Width="92" Margin="0,0,8,0"
              Click="Cancel_Click" IsCancel="True"/>
      <Button Content="Apply" Style="{StaticResource AccentButton}" Width="100"
              IsDefault="True" Click="Apply_Click"/>
    </StackPanel>
  </StackPanel>
</Window>
