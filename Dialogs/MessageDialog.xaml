<Window x:Class="YorteVegas.Dialogs.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YorteVegas" Width="480" SizeToContent="Height"
        Icon="pack://application:,,,/assets/appicon.png"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#080A11" Foreground="#E6EEF6">
  <Grid Margin="24,20,24,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="15" FontWeight="SemiBold"/>
    <TextBlock x:Name="MessageText" Grid.Row="1" TextWrapping="Wrap" Foreground="#C7D6E6"
               FontSize="11.5" LineHeight="17" Margin="0,10,0,0"/>

    <StackPanel x:Name="ButtonRow" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                Margin="0,20,0,0">
      <Button x:Name="CancelButton" Style="{StaticResource BaseButton}" Width="92" Margin="0,0,8,0"
              Click="Cancel_Click" IsCancel="True"/>
      <Button x:Name="SecondaryButton" Style="{StaticResource BaseButton}" Width="106" Margin="0,0,8,0"
              Click="Secondary_Click"/>
      <Button x:Name="PrimaryButton" Style="{StaticResource AccentButton}" Width="106"
              Click="Primary_Click" IsDefault="True"/>
    </StackPanel>
  </Grid>
</Window>
