<Window x:Class="YorteVegas.Dialogs.NewProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New project" Width="680" SizeToContent="Height"
        Icon="pack://application:,,,/assets/appicon.png"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#080A11" Foreground="#E6EEF6">
  <Window.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#8EA0B4"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>

    <Style x:Key="PresetCard" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#E6EEF6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Background="#111A27" BorderBrush="#1A2636" BorderThickness="1"
                    CornerRadius="6" Padding="11,9">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#16202D"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#2A3E54"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#142334"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#2E9BFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DimText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#8EA0B4"/>
      <Setter Property="FontSize" Value="9.5"/>
      <Setter Property="FontFamily" Value="Consolas, Segoe UI"/>
    </Style>
  </Window.Resources>

  <Grid Margin="24,20,24,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Text="New project" FontSize="17" FontWeight="SemiBold"/>
      <TextBlock Text="Pick the canvas your edit will be built on. You can add tracks and clips next."
                 Foreground="#8EA0B4" FontSize="11" Margin="0,4,0,0"/>
    </StackPanel>

    <StackPanel Grid.Row="1" Margin="0,18,0,0">
      <TextBlock Text="PROJECT NAME" Style="{StaticResource FieldLabel}"/>
      <TextBox x:Name="NameBox" Width="320" HorizontalAlignment="Left" Text="Untitled"/>
    </StackPanel>

    <StackPanel Grid.Row="2" Margin="0,16,0,0">
      <TextBlock Text="RESOLUTION" Style="{StaticResource FieldLabel}"/>
      <UniformGrid Columns="3" Rows="2">
        <RadioButton x:Name="Preset1080" Style="{StaticResource PresetCard}" GroupName="Preset" Tag="1920x1080"
                     Checked="Preset_Checked">
          <StackPanel>
            <TextBlock Text="Full HD" FontWeight="SemiBold" FontSize="11.5"/>
            <TextBlock Text="1920 × 1080" Style="{StaticResource DimText}" Margin="0,3,0,0"/>
            <TextBlock Text="16:9 · the classic" Foreground="#5C6B7E" FontSize="9.5" Margin="0,1,0,0"/>
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="Preset2160" Style="{StaticResource PresetCard}" GroupName="Preset" Tag="3840x2160"
                     Checked="Preset_Checked">
          <StackPanel>
            <TextBlock Text="4K UHD" FontWeight="SemiBold" FontSize="11.5"/>
            <TextBlock Text="3840 × 2160" Style="{StaticResource DimText}" Margin="0,3,0,0"/>
            <TextBlock Text="16:9 · maximum detail" Foreground="#5C6B7E" FontSize="9.5" Margin="0,1,0,0"/>
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="PresetVertical" Style="{StaticResource PresetCard}" GroupName="Preset" Tag="1080x1920"
                     Checked="Preset_Checked">
          <StackPanel>
            <TextBlock Text="Vertical" FontWeight="SemiBold" FontSize="11.5"/>
            <TextBlock Text="1080 × 1920" Style="{StaticResource DimText}" Margin="0,3,0,0"/>
            <TextBlock Text="9:16 · social" Foreground="#5C6B7E" FontSize="9.5" Margin="0,1,0,0"/>
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="PresetSquare" Style="{StaticResource PresetCard}" GroupName="Preset" Tag="1080x1080"
                     Checked="Preset_Checked">
          <StackPanel>
            <TextBlock Text="Square" FontWeight="SemiBold" FontSize="11.5"/>
            <TextBlock Text="1080 × 1080" Style="{StaticResource DimText}" Margin="0,3,0,0"/>
            <TextBlock Text="1:1 · feed" Foreground="#5C6B7E" FontSize="9.5" Margin="0,1,0,0"/>
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="Preset720" Style="{StaticResource PresetCard}" GroupName="Preset" Tag="1280x720"
                     Checked="Preset_Checked">
          <StackPanel>
            <TextBlock Text="HD" FontWeight="SemiBold" FontSize="11.5"/>
            <TextBlock Text="1280 × 720" Style="{StaticResource DimText}" Margin="0,3,0,0"/>
            <TextBlock Text="16:9 · lightweight" Foreground="#5C6B7E" FontSize="9.5" Margin="0,1,0,0"/>
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="PresetCustom" Style="{StaticResource PresetCard}" GroupName="Preset" Tag="custom"
                     Checked="Preset_Checked">
          <StackPanel>
            <TextBlock Text="Custom" FontWeight="SemiBold" FontSize="11.5"/>
            <TextBlock Text="Your size" Style="{StaticResource DimText}" Margin="0,3,0,0"/>
            <TextBlock Text="type width × height" Foreground="#5C6B7E" FontSize="9.5" Margin="0,1,0,0"/>
          </StackPanel>
        </RadioButton>
      </UniformGrid>
    </StackPanel>

    <Grid Grid.Row="3" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="150"/>
        <ColumnDefinition Width="150"/>
        <ColumnDefinition Width="170"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,12,0">
        <TextBlock Text="WIDTH" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="WidthBox" Text="1920"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,12,0">
        <TextBlock Text="HEIGHT" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="HeightBox" Text="1080"/>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="FRAME RATE" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="FpsBox"/>
      </StackPanel>
    </Grid>

    <Border Grid.Row="4" Background="#0D131D" BorderBrush="#1A2636" BorderThickness="1"
            CornerRadius="5" Padding="10,8" Margin="0,16,0,0">
      <TextBlock x:Name="HintText"
                 Text="Tip: add video and audio tracks as your edit grows. Import media with Ctrl+I."
                 Foreground="#6E8095" FontSize="10.5" TextWrapping="Wrap"/>
    </Border>

    <TextBlock x:Name="ErrorText" Grid.Row="5" Foreground="#F87171" FontSize="10.5"
               Margin="0,10,0,0" Visibility="Collapsed"/>

    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="Cancel" Style="{StaticResource BaseButton}" Width="96" Margin="0,0,8,0"
              Click="Cancel_Click" IsCancel="True"/>
      <Button Content="Create project" Style="{StaticResource AccentButton}" Width="132" IsDefault="True"
              Click="Create_Click"/>
    </StackPanel>
  </Grid>
</Window>
