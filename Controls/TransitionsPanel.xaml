<UserControl x:Class="YorteVegas.Controls.TransitionsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0D131D">

  <UserControl.Resources>
    <Style x:Key="TransitionRow" TargetType="Border">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="Margin" Value="0,0,0,1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#16202D"/>
        </Trigger>
        <Trigger Property="Tag" Value="selected">
          <Setter Property="Background" Value="#1E2C3E"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="PresetTile" TargetType="Border">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="Padding" Value="4"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#16202D"/>
        </Trigger>
        <Trigger Property="Tag" Value="selected">
          <Setter Property="Background" Value="#16202D"/>
          <Setter Property="BorderBrush" Value="#9A5CFF"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="GradientSlider" TargetType="Slider">
      <Setter Property="Height" Value="22"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid>
              <Border Height="8" CornerRadius="4" Margin="7,0"
                      Background="#223248"
                      BorderBrush="#223248" BorderThickness="1"
                      VerticalAlignment="Center"/>
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="13" Height="13">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="#F2F7FC" Stroke="#0B121B" StrokeThickness="1.3"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ParamLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#C7D6E6"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ParamValue" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#C7A9FF"/>
      <Setter Property="FontFamily" Value="Consolas, Segoe UI"/>
      <Setter Property="FontSize" Value="9.5"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ParamRange" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#4E6075"/>
      <Setter Property="FontFamily" Value="Consolas, Segoe UI"/>
      <Setter Property="FontSize" Value="8.5"/>
    </Style>

    <Style x:Key="ChoiceChip" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="#8EA0B4"/>
      <Setter Property="FontSize" Value="9.5"/>
      <Setter Property="Padding" Value="8,2"/>
      <Setter Property="Margin" Value="0,0,4,3"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd" CornerRadius="4" Background="#0F1824"
                    BorderBrush="#223248" BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#16202D"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#4A3A66"/>
                <Setter Property="Foreground" Value="#DCE8F4"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#3A2A5E"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#9A5CFF"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SmallToolButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
      <Setter Property="Width" Value="24"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Margin" Value="3,0,0,0"/>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid x:Name="ContentGrid">
      <Grid.RowDefinitions>
        <RowDefinition Height="44"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="26"/>
      </Grid.RowDefinitions>

      <!-- header -->
      <Grid Grid.Row="0" Margin="14,0,10,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="TRANSITIONS" FontSize="10" FontWeight="SemiBold" Foreground="#C7D6E6"/>
          <Border Background="#0F1824" BorderBrush="#223248" BorderThickness="1"
                  CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="ClipNameText" Foreground="#8EA0B4" FontSize="9.5"
                       TextTrimming="CharacterEllipsis" MaxWidth="200"/>
          </Border>
        </StackPanel>
        <TextBlock Text="Drag onto an overlap or a clip edge"
                   HorizontalAlignment="Right" VerticalAlignment="Center"
                   Foreground="#3F4F63" FontSize="8.5"/>
      </Grid>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="150"/>
          <ColumnDefinition Width="1"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- transition list -->
        <Border Grid.Column="0" Background="#0B121B" BorderBrush="#1A2636" BorderThickness="1"
                CornerRadius="5" Margin="10,0,0,8" Padding="4,6,4,6">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="TransitionListHost"/>
          </ScrollViewer>
        </Border>

        <Border Grid.Column="1" Background="#1A2636" Margin="0,0,0,8"/>

        <!-- presets + parameters -->
        <Grid Grid.Column="2" Margin="12,0,10,8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <TextBlock x:Name="TransitionTitle" FontSize="12.5" FontWeight="SemiBold"/>
              <TextBlock x:Name="TransitionDescription" Foreground="#7A8EA4" FontSize="9.5"
                         Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="8,0,0,0">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ToggleButton x:Name="InSlotToggle" Content="IN" Style="{StaticResource ChoiceChip}"
                              Click="InSlot_Click" ToolTip="Transition at the start of the clip"/>
                <ToggleButton x:Name="OutSlotToggle" Content="OUT" Style="{StaticResource ChoiceChip}"
                              Click="OutSlot_Click" ToolTip="Transition at the end of the clip"/>
              </StackPanel>
              <StackPanel x:Name="AppliedControls" Orientation="Horizontal"
                          HorizontalAlignment="Right" Margin="0,4,0,0" Visibility="Collapsed">
                <ToggleButton x:Name="EnabledToggle" Content="ON" Style="{StaticResource ChoiceChip}"
                              Margin="0,0,5,0" Click="EnabledToggle_Click"
                              ToolTip="Enable or bypass this transition"/>
                <Button x:Name="RemoveButton" Content="&#x2715;" FontFamily="Segoe UI"
                        FontSize="11" Foreground="#E08A8A"
                        Style="{StaticResource SmallToolButton}" Click="Remove_Click"
                        ToolTip="Remove this transition"/>
              </StackPanel>
            </StackPanel>
          </Grid>

          <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10">
            <StackPanel x:Name="PresetHost" Orientation="Horizontal"/>
          </ScrollViewer>

          <Border Grid.Row="2" Background="#1A2636"/>

          <ScrollViewer Grid.Row="3" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ParamHost"/>
          </ScrollViewer>
        </Grid>
      </Grid>

      <TextBlock Grid.Row="2" Text="Drag a preset onto a crossfade, or onto the left/right half of a clip."
                 Foreground="#3F4F63" FontSize="9" Margin="14,0,10,0"
                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
    </Grid>

    <TextBlock x:Name="EmptyState"
               Text="Select a video or image clip to add a transition."
               Foreground="#4E6075" FontSize="10.5" TextWrapping="Wrap"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               TextAlignment="Center" MaxWidth="230" Visibility="Collapsed"/>
  </Grid>
</UserControl>
