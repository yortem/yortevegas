<Window x:Class="YorteVegas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:YorteVegas.Controls"
        Title="YorteVegas" Width="1440" Height="900" MinWidth="1080" MinHeight="680"
        Icon="pack://application:,,,/assets/appicon.png"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#080A11" Foreground="#E6EEF6" FontSize="11.5"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded" Closing="Window_Closing" StateChanged="Window_StateChanged">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="38" ResizeBorderThickness="8" GlassFrameThickness="0"
                  CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <!-- ================================================================ rail -->
    <Style x:Key="RailButton" TargetType="ToggleButton">
      <Setter Property="Width" Value="38"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Margin" Value="0,0,0,3"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#6E8095"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd" CornerRadius="7" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#16202D"/>
                <Setter Property="Foreground" Value="#DCE8F4"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#1E2C3E"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="MenuButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="#9AACC0"/>
      <Setter Property="Margin" Value="0,0,1,0"/>
    </Style>

    <Style x:Key="PlayButton" TargetType="Button">
      <Setter Property="Width" Value="30"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Background" Value="#E6EEF6"/>
      <Setter Property="Foreground" Value="#0B121B"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="15" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FFFFFF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#C7D6E6"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TransportButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
      <Setter Property="Width" Value="25"/>
      <Setter Property="Height" Value="25"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Foreground" Value="#8EA0B4"/>
    </Style>

    <Style x:Key="StripButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
      <Setter Property="Padding" Value="7,4"/>
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="Foreground" Value="#9AACC0"/>
    </Style>

    <Style x:Key="StripToggle" TargetType="ToggleButton">
      <Setter Property="Padding" Value="9,4"/>
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="Foreground" Value="#9AACC0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd" CornerRadius="4" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#1A2534"/>
                <Setter Property="Foreground" Value="#E6EEF6"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#1E2C3E"/>
                <Setter Property="Foreground" Value="#E6EEF6"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DividerLine" TargetType="Border">
      <Setter Property="Width" Value="1"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="Background" Value="#1E2A3A"/>
      <Setter Property="Margin" Value="7,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ExportPill" TargetType="Button">
      <Setter Property="Height" Value="25"/>
      <Setter Property="Padding" Value="11,0"/>
      <Setter Property="Margin" Value="0,7,10,0"/>
      <Setter Property="Background" Value="#0F1824"/>
      <Setter Property="BorderBrush" Value="#223248"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="#8EA0B4"/>
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="13" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#16202D"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#2E4A66"/>
                <Setter Property="Foreground" Value="#C7D6E6"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#1E2C3E"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============================================================ menus -->
    <PathGeometry x:Key="IconNew" Figures="M 4,1 H 10 L 13,4 V 13 H 4 Z M 10,1 V 4 H 13 M 8.5,6.5 V 11 M 6,8.75 H 11"/>
    <PathGeometry x:Key="IconOpen" Figures="M 1,4 H 6 L 8,6 H 14 V 12 H 1 Z"/>
    <PathGeometry x:Key="IconSave" Figures="M 2,2 H 11 L 14,5 V 13 H 2 Z M 4,2 V 6 H 10 V 2 M 4,9 H 12 V 13 H 4 Z"/>
    <PathGeometry x:Key="IconImport" Figures="M 8,1.5 V 9.5 M 4.5,6 L 8,9.5 L 11.5,6 M 2,12.5 H 14"/>
    <PathGeometry x:Key="IconExport" Figures="M 8,12 V 4 M 4.5,7.5 L 8,4 L 11.5,7.5 M 2,1.5 H 14"/>
    <PathGeometry x:Key="IconExit" Figures="M 9,2 H 13 V 14 H 9 M 2,8 H 9.5 M 6.5,5 L 3.5,8 L 6.5,11"/>
    <PathGeometry x:Key="IconUndo" Figures="M 3.5,4.5 A 6,6 0 1 1 2,8 M 3.5,4.5 V 1.5 M 3.5,4.5 H 6.5"/>
    <PathGeometry x:Key="IconRedo" Figures="M 10.5,4.5 A 6,6 0 1 0 12,8 M 10.5,4.5 V 1.5 M 10.5,4.5 H 7.5"/>
    <PathGeometry x:Key="IconSplit" Figures="M 7,1 V 13 M 8,1 V 13 M 3,4 L 6,7 L 3,10"/>
    <PathGeometry x:Key="IconDuplicate" Figures="M 3,2 H 10 V 9 H 3 Z M 6,5 H 13 V 12 H 6 Z"/>
    <PathGeometry x:Key="IconDelete" Figures="M 3,4 H 13 M 6,4 V 2 H 10 V 4 M 4.5,4 L 5,13 H 11 L 11.5,4"/>
    <PathGeometry x:Key="IconFit" Figures="M 2,5 V 2 H 5 M 9,2 H 12 V 5 M 12,9 V 12 H 9 M 5,12 H 2 V 9"/>
    <PathGeometry x:Key="IconShortcuts" Figures="M 2,4 H 14 V 11 H 2 Z M 4,6.5 H 4.6 M 6.4,6.5 H 7 M 8.8,6.5 H 9.4 M 11.2,6.5 H 11.8 M 4,8.5 H 12"/>
    <PathGeometry x:Key="IconAbout" Figures="M 8,2 A 6,6 0 1 1 7.99,2 M 8,6.5 V 10.5 M 8,4.5 V 4.6"/>
    <PathGeometry x:Key="IconCheck" Figures="M 1,7 L 5,11 L 12,3"/>
    <PathGeometry x:Key="IconZoomIn" Figures="M 6.5,1 A 5.5,5.5 0 1 1 6.49,1 M 10.5,10.5 L 14,14 M 4,6.5 H 9 M 6.5,4 V 9"/>
    <PathGeometry x:Key="IconZoomOut" Figures="M 6.5,1 A 5.5,5.5 0 1 1 6.49,1 M 10.5,10.5 L 14,14 M 4,6.5 H 9"/>

    <ContextMenu x:Key="FileMenu">
      <MenuItem Header="New project" InputGestureText="Ctrl+N" Click="NewProject_Click"><MenuItem.Icon><Path Data="{StaticResource IconNew}" Stroke="#7FA6C8" StrokeThickness="1.3" Width="15" Height="15" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></MenuItem.Icon></MenuItem>
      <MenuItem Header="Open project…" InputGestureText="Ctrl+O" Click="OpenProject_Click"><MenuItem.Icon><Path Data="{StaticResource IconOpen}" Stroke="#7FA6C8" StrokeThickness="1.3" Width="15" Height="15" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></MenuItem.Icon></MenuItem>
      <Separator/>
      <MenuItem Header="Save" InputGestureText="Ctrl+S" Click="Save_Click"><MenuItem.Icon><Path Data="{StaticResource IconSave}" Stroke="#7FA6C8" StrokeThickness="1.3" Width="15" Height="15" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></MenuItem.Icon></MenuItem>
      <MenuItem Header="Save as…" InputGestureText="Ctrl+Shift+S" Click="SaveAs_Click"><MenuItem.Icon><Path Data="{StaticResource IconSave}" Stroke="#7FA6C8" StrokeThickness="1.3" Width="15" Height="15" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></MenuItem.Icon></MenuItem>
      <Separator/>
      <MenuItem Header="Import media…" InputGestureText="Ctrl+I" Click="ImportMedia_Click"><MenuItem.Icon><Path Data="{StaticResource IconImport}" Stroke="#7FA6C8" StrokeThickness="1.3" Width="15" Height="15" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></MenuItem.Icon></MenuItem>
      <Separator/>
      <MenuItem Header="Export video…" InputGestureText="Ctrl+E" Click="Export_Click"><MenuItem.Icon><Path Data="{StaticResource IconExport}" Stroke="#7FA6C8" StrokeThickness="1.3" Width="15" Height="15" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></MenuItem.Icon></MenuItem>
      <Separator/>
      <MenuItem Header="Exit" Click="Exit_Click"><MenuItem.Icon><Path Data="{StaticResource IconExit}" Stroke="#7FA6C8" StrokeThickness="1.3" Width="15" Height="15" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></MenuItem.Icon></MenuItem>
    </ContextMenu>

    <ContextMenu x:Key="EditMenu">
      <MenuItem Header="Undo" InputGestureText="Ctrl+Z" Click="Undo_Click"><MenuItem.Icon><Path Data="{StaticResource IconUndo}" Stroke="#7FA6C8" StrokeThickness="1.3" Width="15" Height="15" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></MenuItem.Icon></MenuItem>
      <MenuItem Header="Redo" InputGestureText="Ctrl+Y" Click="Redo_Click"><MenuItem.Icon><Path Data="{StaticResource IconRedo}" Stroke="#7FA6C8" StrokeThickness="1.3" Width="15" Height="15" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></MenuItem.Icon></MenuItem>
      <Separator/>
      <MenuItem Header="Split at playhead" InputGestureText="S" Click="Split_Click"><MenuItem.Icon><Path Data="{StaticResource IconSplit}" Stroke="#7FA6C8" StrokeThickness="1.3" Width="15" Height="15" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></MenuItem.Icon></MenuItem>
      <MenuItem Header="Duplicate clip" InputGestureText="Ctrl+D" Click="Duplicate_Click"><MenuItem.Icon><Path Data="{StaticResource IconDuplicate}" Stroke="#7FA6C8" StrokeThickness="1.3" Width="15" Height="15" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></MenuItem.Icon></MenuItem>
      <MenuItem Header="Delete clip" InputGestureText="Del" Click="Delete_Click"><MenuItem.Icon><Path Data="{StaticResource IconDelete}" Stroke="#7FA6C8" StrokeThickness="1.3" Width="15" Height="15" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></MenuItem.Icon></MenuItem>
    </ContextMenu>

    <ContextMenu x:Key="ViewMenu">
      <MenuItem Header="Zoom in" InputGestureText="Ctrl+ +" Click="ZoomIn_Click"><MenuItem.Icon><Path Data="{StaticResource IconZoomIn}" Stroke="#7FA6C8" StrokeThickness="1.3" Width="15" Height="15" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></MenuItem.Icon></MenuItem>
      <MenuItem Header="Zoom out" InputGestureText="Ctrl+ −" Click="ZoomOut_Click"><MenuItem.Icon><Path Data="{StaticResource IconZoomOut}" Stroke="#7FA6C8" StrokeThickness="1.3" Width="15" Height="15" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></MenuItem.Icon></MenuItem>
      <MenuItem Header="Fit timeline" InputGestureText="F" Click="ZoomFit_Click"><MenuItem.Icon><Path Data="{StaticResource IconFit}" Stroke="#7FA6C8" StrokeThickness="1.3" Width="15" Height="15" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></MenuItem.Icon></MenuItem>
      <Separator/>
      <MenuItem Header="Snap to edges" IsCheckable="True" IsChecked="True"
                Click="SnapMenuItem_Click"/>
    </ContextMenu>

    <ContextMenu x:Key="HelpMenu">
      <MenuItem Header="Keyboard shortcuts" Click="Shortcuts_Click"><MenuItem.Icon><Path Data="{StaticResource IconShortcuts}" Stroke="#7FA6C8" StrokeThickness="1.3" Width="15" Height="15" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></MenuItem.Icon></MenuItem>
      <MenuItem Header="About YorteVegas" Click="About_Click"><MenuItem.Icon><Path Data="{StaticResource IconAbout}" Stroke="#7FA6C8" StrokeThickness="1.3" Width="15" Height="15" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></MenuItem.Icon></MenuItem>
    </ContextMenu>

    <!-- ======================================================== media items -->
    <DataTemplate x:Key="MediaItemTemplate">
      <Border Margin="0,0,0,3" Padding="8,7" CornerRadius="5" Background="Transparent">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="62"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Border Width="60" Height="40" CornerRadius="4" Background="#070B12"
                  BorderBrush="#1A2636" BorderThickness="1" VerticalAlignment="Center"
                  ClipToBounds="True">
            <Grid>
              <TextBlock Text="{Binding Kind}" Foreground="#33445A" FontSize="9" FontWeight="SemiBold"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                     RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>
          </Border>

          <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding FilePath}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="#DCE8F4"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                      <Setter Property="Foreground" Value="#F87171"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding MetaLabel}" Foreground="#7A8EA4" FontSize="10"
                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
          </StackPanel>

          <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0,2,0">
            <Border Background="#0B121B" BorderBrush="#223248" BorderThickness="1"
                    CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
              <TextBlock Text="{Binding DurationLabel}" Foreground="#DCE8F4"
                         FontFamily="Consolas, Segoe UI" FontSize="10.5" FontWeight="SemiBold"
                         HorizontalAlignment="Right"/>
            </Border>
            <TextBlock Text="LENGTH" Foreground="#4E6075" FontFamily="Consolas, Segoe UI"
                       FontSize="7.5" HorizontalAlignment="Right" Margin="0,3,1,0"/>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="38"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ============================================================ title bar -->
    <Border Grid.Row="0" Background="#0D131D" BorderBrush="#1A2636" BorderThickness="0,0,0,1"
            WindowChrome.IsHitTestVisibleInChrome="True"
            PreviewMouseLeftButtonDown="TitleBar_PreviewMouseLeftButtonDown">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,4,0">
          <Image Width="24" Height="24" VerticalAlignment="Center"
                 Source="pack://application:,,,/assets/appicon.png"
                 RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="YorteVegas" FontWeight="Bold" FontSize="12" Margin="8,0,0,0"
                     VerticalAlignment="Center"/>
          <Border Width="1" Height="14" Background="#223248" Margin="10,0"/>
          <TextBlock x:Name="ProjectNameText" Text="Untitled" FontSize="11" Foreground="#DCE8F4"
                     VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="ProjectDirtyText" Text="•" Foreground="#F2B23A" FontSize="14"
                     Margin="5,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                     ToolTip="Unsaved changes"/>
          <TextBlock x:Name="ProjectMetaText" Text="1920 × 1080 · 30 fps" Foreground="#5C6B7E"
                     FontFamily="Consolas, Segoe UI" FontSize="10" Margin="12,0,0,0"
                     VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
          <Button x:Name="FileMenuButton" Style="{StaticResource MenuButton}" Content="File"
                  ContextMenu="{StaticResource FileMenu}" Click="OpenMenu_Click"
                  WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button Style="{StaticResource MenuButton}" Content="Edit"
                  ContextMenu="{StaticResource EditMenu}" Click="OpenMenu_Click"
                  WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button Style="{StaticResource MenuButton}" Content="View"
                  ContextMenu="{StaticResource ViewMenu}" Click="OpenMenu_Click"
                  WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button Style="{StaticResource MenuButton}" Content="Help"
                  ContextMenu="{StaticResource HelpMenu}" Click="OpenMenu_Click"
                  WindowChrome.IsHitTestVisibleInChrome="True"/>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center"
                    VerticalAlignment="Center">
          <Ellipse x:Name="StatusDot" Width="5" Height="5" Fill="#3DDC97" VerticalAlignment="Center"/>
          <TextBlock x:Name="StatusText" Text="READY" Foreground="#6E8095" FontFamily="Consolas, Segoe UI"
                     FontSize="9.5" Margin="7,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
          <Button x:Name="ExportButton" Style="{StaticResource ExportPill}"
                  ToolTip="Export video (Ctrl+E)" Click="Export_Click"
                  WindowChrome.IsHitTestVisibleInChrome="True">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Export" FontSize="10.5" Foreground="#8EA0B4" VerticalAlignment="Center"/>
              <Path Data="M12 17 V5 M7 10 L12 5 L17 10" Width="9" Height="9" Stretch="Uniform"
                    Stroke="#5C6B7E" StrokeThickness="1.6" StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="6,0,0,0"
                    VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource TitleBarButton}" Click="WindowMinimize_Click" ToolTip="Minimize"
                  WindowChrome.IsHitTestVisibleInChrome="True">
            <TextBlock Text="&#xE921;" FontFamily="{StaticResource IconFont}" FontSize="10"/>
          </Button>
          <Button Style="{StaticResource TitleBarButton}" Click="WindowMaximizeRestore_Click" ToolTip="Maximize"
                  WindowChrome.IsHitTestVisibleInChrome="True">
            <TextBlock x:Name="MaxRestoreGlyph" Text="&#xE922;" FontFamily="{StaticResource IconFont}" FontSize="10"/>
          </Button>
          <Button Style="{StaticResource TitleBarCloseButton}" Click="WindowClose_Click" ToolTip="Close"
                  WindowChrome.IsHitTestVisibleInChrome="True">
            <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="10"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============================================================ workspace -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="48"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- rail -->
      <Border Grid.Column="0" Background="#0D131D" BorderBrush="#1A2636" BorderThickness="0,0,1,0">
        <Grid Margin="0,7">
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" HorizontalAlignment="Center">
            <ToggleButton x:Name="RailAll" Style="{StaticResource RailButton}" IsChecked="True"
                          Click="RailFilter_Click" Tag="all" ToolTip="All media">
              <Path Data="M3 7 H10 L12 9 H21 V19 H3 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                    StrokeThickness="1.6" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform"/>
            </ToggleButton>
            <ToggleButton x:Name="RailVideo" Style="{StaticResource RailButton}" Click="RailFilter_Click"
                          Tag="video" ToolTip="Video clips">
              <Path Data="M3 6 H21 V18 H3 Z M8 6 V18 M16 6 V18 M3 12 H21"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                    StrokeThickness="1.6" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform"/>
            </ToggleButton>
            <ToggleButton x:Name="RailAudio" Style="{StaticResource RailButton}" Click="RailFilter_Click"
                          Tag="audio" ToolTip="Audio clips">
              <Path Data="M9 18 V6 L20 4 V16 M9 18 A2.5 2.5 0 1 1 4 18 A2.5 2.5 0 1 1 9 18 M20 16 A2.5 2.5 0 1 1 15 16 A2.5 2.5 0 1 1 20 16"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                    StrokeThickness="1.5" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform"/>
            </ToggleButton>
            <ToggleButton x:Name="RailImage" Style="{StaticResource RailButton}" Click="RailFilter_Click"
                          Tag="image" ToolTip="Images">
              <Path Data="M3 5 H21 V19 H3 Z M7 15 L11 11 L14 14 L17 11.5 L21 15.5 M8 9 A1 1 0 1 1 8 9.01"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                    StrokeThickness="1.6" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform"/>
            </ToggleButton>
          </StackPanel>

          <Button Grid.Row="1" Style="{StaticResource GhostButton}" Width="38" Height="38" Padding="0"
                  HorizontalAlignment="Center" Click="Settings_Click" ToolTip="Settings">
            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="13"
                       Foreground="#8EA0B4"/>
          </Button>
        </Grid>
      </Border>

      <!-- workspace -->
      <Grid Grid.Column="1" Background="#090A0C">
        <Grid.RowDefinitions>
          <RowDefinition Height="3*" MinHeight="250"/>
          <RowDefinition Height="6"/>
          <RowDefinition Height="2*" MinHeight="190"/>
          <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- upper: library + monitor -->
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" MinWidth="300"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="7*" MinWidth="380"/>
          </Grid.ColumnDefinitions>

          <!-- media library -->
          <Border Grid.Column="0" Background="#0C0D10" BorderBrush="#141E2A" BorderThickness="0,0,1,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="31"/>
                <RowDefinition Height="27"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="22"/>
              </Grid.RowDefinitions>

              <Grid Grid.Row="0" Margin="12,0,8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="MEDIA LIBRARY" FontSize="10" FontWeight="SemiBold" Foreground="#C7D6E6"/>
                  <TextBlock x:Name="LibraryCountText" Text="0" Foreground="#4E6075" FontFamily="Consolas, Segoe UI"
                             FontSize="9.5" Margin="7,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Style="{StaticResource BaseButton}" HorizontalAlignment="Right" Padding="9,3"
                        FontSize="10" Click="ImportMedia_Click" ToolTip="Import media (Ctrl+I)">
                  <StackPanel Orientation="Horizontal">
                    <Path Data="M12 4 V15 M7 10 L12 15 L17 10 M4 19 H20" Width="11" Height="11"
                          Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" VerticalAlignment="Center"/>
                    <TextBlock Text="Import" Margin="5,0,0,0" FontSize="10" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </Grid>

              <Grid Grid.Row="1" Margin="10,0,10,3">
                <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" TextChanged="SearchBox_TextChanged"/>
                <TextBlock Text="Filter media…" Foreground="#4E6075" FontSize="10.5" Margin="9,0,0,0"
                           IsHitTestVisible="False" VerticalAlignment="Center">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>

              <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="8,0,8,4">
                <ToggleButton x:Name="ChipAll" Style="{StaticResource ChipToggle}" Content="All"
                              IsChecked="True" Tag="all" Click="ChipFilter_Click"/>
                <ToggleButton x:Name="ChipVideo" Style="{StaticResource ChipToggle}" Content="Video"
                              Tag="video" Click="ChipFilter_Click"/>
                <ToggleButton x:Name="ChipAudio" Style="{StaticResource ChipToggle}" Content="Audio"
                              Tag="audio" Click="ChipFilter_Click"/>
                <ToggleButton x:Name="ChipImage" Style="{StaticResource ChipToggle}" Content="Images"
                              Tag="image" Click="ChipFilter_Click"/>
              </StackPanel>

              <ListBox x:Name="MediaList" Grid.Row="3" Margin="6,0,4,0" ItemTemplate="{StaticResource MediaItemTemplate}"
                       MouseDoubleClick="MediaList_MouseDoubleClick"
                       SelectionChanged="MediaList_SelectionChanged"
                       PreviewMouseLeftButtonDown="MediaList_PreviewMouseLeftButtonDown"
                       PreviewMouseMove="MediaList_PreviewMouseMove"
                       AllowDrop="True" Drop="MediaList_Drop"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Add to timeline" Click="AddSelectedAsset_Click"/>
                    <MenuItem Header="Remove from library" Click="RemoveSelectedAsset_Click"/>
                  </ContextMenu>
                </ListBox.ContextMenu>
              </ListBox>

              <TextBlock x:Name="LibraryHintText" Grid.Row="4" Text="Double-click a clip to add it at the playhead"
                         Foreground="#3F4F63" FontSize="9.5" Margin="12,0,8,0" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"/>
            </Grid>
          </Border>

          <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#090A0C"
                        BorderBrush="#1A2636" BorderThickness="1,0,0,0" ResizeBehavior="PreviousAndNext"
                        ResizeDirection="Columns"/>

          <!-- monitor -->
          <Grid Grid.Column="2" Background="#08090B">
            <Grid.RowDefinitions>
              <RowDefinition Height="30"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="46"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="14,0,12,0">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="MONITOR" FontSize="9.5" FontWeight="SemiBold" Foreground="#C7D6E6"/>
                <TextBlock x:Name="MonitorResolutionText" Text="1920 × 1080" Foreground="#5C6B7E"
                           FontFamily="Consolas, Segoe UI" FontSize="9.5" Margin="10,0,0,0"/>
                <TextBlock x:Name="MonitorFpsText" Text="30 fps" Foreground="#5C6B7E"
                           FontFamily="Consolas, Segoe UI" FontSize="9.5" Margin="7,0,0,0"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="MonitorAspectText" Text="16:9" Foreground="#3F4F63" FontFamily="Consolas, Segoe UI"
                           FontSize="9.5" Margin="0,0,10,0"/>
                <TextBlock Text="FIT" Foreground="#3F4F63" FontFamily="Consolas, Segoe UI" FontSize="9.5"/>
              </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="#000000" Margin="12,0,12,6" BorderBrush="#10161F"
                    BorderThickness="1">
              <Grid>
                <controls:PreviewCompositor x:Name="Preview" Visibility="Collapsed"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                <Grid x:Name="PreviewPlaceholder" Background="#05070A">
                  <StackPanel x:Name="PreviewPlaceholderContent" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="M3 6 H21 V18 H3 Z M7 6 V18 M17 6 V18 M3 12 H21" Width="34" Height="24"
                          Stretch="Uniform" Stroke="#253241" StrokeThickness="1.4" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="PreviewPlaceholderText" Text="No clip at playhead" Foreground="#5C6B7E"
                               FontSize="11" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="PreviewPlaceholderHint"
                               Text="Add media to the timeline, then move the playhead over it."
                               Foreground="#36465A" FontSize="9.5" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Grid>
              </Grid>
            </Border>

            <Grid Grid.Row="2" Background="#08090B">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <TextBlock x:Name="CurrentTimeText" Text="00:00:00:00" Foreground="#DCE8F4"
                           FontFamily="Consolas, Segoe UI" FontSize="11.5" VerticalAlignment="Center"/>
                <TextBlock Text="/" Foreground="#33445A" FontSize="10" Margin="7,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TotalTimeText" Text="00:00:00:00" Foreground="#5C6B7E"
                           FontFamily="Consolas, Segoe UI" FontSize="10.5" VerticalAlignment="Center"/>
              </StackPanel>

              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource TransportButton}" Click="SeekStart_Click" ToolTip="Go to start (Home)">
                  <Path Data="M6 5 V19 M18 5 L9 12 L18 19 Z" Width="11" Height="11" Stretch="Uniform"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
                <Button Style="{StaticResource TransportButton}" Click="PrevFrame_Click" ToolTip="Previous frame (←)">
                  <Path Data="M16 5 L7 12 L16 19 Z" Width="11" Height="11" Stretch="Uniform"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.7" StrokeLineJoin="Round"/>
                </Button>
                <Button x:Name="PlayButton" Style="{StaticResource PlayButton}" Margin="7,0" Click="PlayPause_Click"
                        ToolTip="Play / pause (Space)">
                  <Path x:Name="PlayIcon" Data="M8 5 L19 12 L8 19 Z" Width="10" Height="10" Stretch="Uniform"
                        Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
                <Button Style="{StaticResource TransportButton}" Click="NextFrame_Click" ToolTip="Next frame (→)">
                  <Path Data="M8 5 L17 12 L8 19 Z" Width="11" Height="11" Stretch="Uniform"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.7" StrokeLineJoin="Round"/>
                </Button>
                <Button Style="{StaticResource TransportButton}" Click="SeekEnd_Click" ToolTip="Go to end (End)">
                  <Path Data="M18 5 V19 M6 5 L15 12 L6 19 Z" Width="11" Height="11" Stretch="Uniform"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.7" StrokeLineJoin="Round"/>
                </Button>
              </StackPanel>

              <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                          VerticalAlignment="Center" Margin="0,0,14,0">
                <Path Data="M4 9 L8 5 V19 L4 15 H2 V9 Z M11 8 A4 4 0 0 1 11 16 M13.5 5.5 A7.5 7.5 0 0 1 13.5 18.5"
                      Width="13" Height="13" Stretch="Uniform" Stroke="#6E8095" StrokeThickness="1.4"
                      StrokeLineJoin="Round" VerticalAlignment="Center"/>
                <Border Width="46" Height="4" Background="#101A26" CornerRadius="2"
                        Margin="9,0,3,0" VerticalAlignment="Center" ToolTip="Output level">
                  <Rectangle x:Name="LevelMeterFill" HorizontalAlignment="Left" Width="0"
                             RadiusX="2" RadiusY="2" Fill="#3DDC97"/>
                </Border>
                <Slider x:Name="VolumeSlider" Style="{StaticResource ThinSlider}" Width="76" Minimum="0" Maximum="100"
                        SmallChange="1" LargeChange="5" Margin="7,0,0,0" VerticalAlignment="Center"
                        ValueChanged="VolumeSlider_ValueChanged" ToolTip="Preview volume"/>
              </StackPanel>
            </Grid>
          </Grid>
        </Grid>

        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="#090A0C"
                      BorderBrush="#1A2636" BorderThickness="0,1,0,1" ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Rows"/>

        <!-- timeline -->
        <Border Grid.Row="2" Background="#07080A" BorderBrush="#141E2A" BorderThickness="0,0,0,0">
          <controls:TimelineView x:Name="Timeline" AllowDrop="True" DragOver="Timeline_DragOver"
                                 Drop="Timeline_Drop"/>
        </Border>

        <!-- bottom strip -->
        <Border Grid.Row="3" Background="#090A0D" BorderBrush="#141E2A" BorderThickness="0,1,0,0">
          <Grid Margin="8,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="UndoButton" Style="{StaticResource IconButton}" Click="Undo_Click" ToolTip="Undo (Ctrl+Z)">
                <Path Data="M9 7 L4 12 L9 17 M4 12 H14 A4 4 0 0 1 14 20 H12" Width="13" Height="13"
                      Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              </Button>
              <Button x:Name="RedoButton" Style="{StaticResource IconButton}" Click="Redo_Click" ToolTip="Redo (Ctrl+Y)">
                <Path Data="M15 7 L20 12 L15 17 M20 12 H10 A4 4 0 0 0 10 20 H12" Width="13" Height="13"
                      Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              </Button>
              <Button x:Name="DeleteButton" Style="{StaticResource IconButton}" Click="Delete_Click" ToolTip="Delete clip (Del)">
                <Path Data="M4 7 H20 M9 7 V4 H15 V7 M6 7 L7 21 H17 L18 7 M10 11 V17 M14 11 V17"
                      Width="13" Height="13" Stretch="Uniform"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.6" StrokeLineJoin="Round"/>
              </Button>
              <Border Style="{StaticResource DividerLine}"/>
              <TextBlock x:Name="SelectionText" Text="No clip selected" Foreground="#5C6B7E" FontSize="10"
                         VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <ToggleButton x:Name="RazorToggle" Style="{StaticResource StripToggle}" Content="Razor"
                            Click="RazorToggle_Click" ToolTip="Razor tool: click a clip to cut it"/>
              <ToggleButton x:Name="SnapToggle" Style="{StaticResource StripToggle}" Content="Snap"
                            IsChecked="True" Click="SnapToggle_Click" ToolTip="Snap edits to clip edges and the playhead"/>
              <Border Style="{StaticResource DividerLine}"/>
              <Button Style="{StaticResource IconButton}" Click="ZoomOut_Click" ToolTip="Zoom out">
                <TextBlock Text="&#xE71F;" FontFamily="{StaticResource IconFont}" FontSize="9"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
              </Button>
              <TextBlock x:Name="ZoomText" Text="48 px/s" Foreground="#5C6B7E" FontFamily="Consolas, Segoe UI"
                         FontSize="9.5" VerticalAlignment="Center" Margin="5,0" Width="52"
                         TextAlignment="Center"/>
              <Button Style="{StaticResource IconButton}" Click="ZoomIn_Click" ToolTip="Zoom in">
                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="9"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
              </Button>
              <Button Style="{StaticResource StripButton}" Content="Fit" Click="ZoomFit_Click" ToolTip="Fit timeline (F)"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Style="{StaticResource StripButton}" Content="Split" Click="Split_Click" ToolTip="Split at playhead (S)"/>
              <Button Style="{StaticResource StripButton}" Content="Duplicate" Click="Duplicate_Click" ToolTip="Duplicate clip (Ctrl+D)"/>
              <Border Style="{StaticResource DividerLine}"/>
              <Button Style="{StaticResource StripButton}" Content="+ Video" Click="AddVideoTrack_Click" ToolTip="Add a video track"/>
              <Button Style="{StaticResource StripButton}" Content="+ Audio" Click="AddAudioTrack_Click" ToolTip="Add an audio track"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
